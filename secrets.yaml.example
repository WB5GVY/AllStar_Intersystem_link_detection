# AllStar Link Detector — Secrets Configuration
#
# Copy this file to: ~/.config/asl_link_detector/secrets.yaml
# Then set permissions: chmod 600 ~/.config/asl_link_detector/secrets.yaml
#
# These credentials are loaded at runtime and merged into the main config.
# NEVER commit this file to version control.

email:
  username: "your_email@gmail.com"       # Gmail address (or other SMTP provider)
  password: "your_app_password"          # Gmail App Password (not your regular password)
  from_addr: "your_email@gmail.com"      # "From" address on outgoing emails
  # Full recipient list. Violation-class emails (paths #1 and #2) reach
  # every address here. The chokepoint subtracts `internal_recipients` to
  # compute who is "external" and subject to the 6-hour-per-recipient cap.
  recipients:
    - "internal_operator@example.com"
    - "external_operator1@example.com"
    - "external_operator2@example.com"
  # Bennett-only list (post-2026-05-14 chokepoint refactor). Anomaly,
  # operator-awareness, error-report, and test emails route here ONLY,
  # regardless of what the caller passes. REQUIRED — the daemon refuses
  # to start if both this and the legacy `hidden_path_recipients` are
  # missing. Fails closed if present-but-empty, present-but-whitespace,
  # or otherwise yielding zero non-blank entries after stripping
  # (audit fail-closed fix C1).
  internal_recipients:
    - "internal_operator@example.com"
  # Legacy alias for internal_recipients, honored when internal_recipients
  # is missing. Prefer the new field. Will be removed in a future version.
  # hidden_path_recipients:
  #   - "internal_operator@example.com"

qrz:
  username: "YOUR_CALLSIGN"             # QRZ.com username (your callsign)
  password: "your_qrz_password"         # QRZ.com password (requires XML subscription)
